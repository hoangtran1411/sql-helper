package main

import (
	"fmt"
	"strings"

	"github.com/wailsapp/wails/v3/pkg/application"
)

// App struct holds application service state
type App struct{}

// NewApp creates a new App application service
func NewApp() *App {
	return &App{}
}

// ============ File Dialogs ============

// SelectFile opens a file selection dialog
func (a *App) SelectFile(title string, patterns []string) (string, error) {
	filters := []application.FileFilter{}
	if len(patterns) > 0 {
		filters = append(filters, application.FileFilter{
			DisplayName: "Allowed Files",
			Pattern:     strings.Join(patterns, ";"),
		})
	}

	dialog := application.Get().Dialog.OpenFileWithOptions(&application.OpenFileDialogOptions{
		Title:   title,
		Filters: filters,
	})

	filePath, err := dialog.PromptForSingleSelection()
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "cancel") {
			return "", nil // User cancelled
		}
		return "", err
	}
	return filePath, nil
}

// SelectFolder opens a directory selection dialog
func (a *App) SelectFolder(title string) (string, error) {
	dialog := application.Get().Dialog.OpenFileWithOptions(&application.OpenFileDialogOptions{
		Title:                title,
		CanChooseDirectories: true,
		CanChooseFiles:       false,
	})

	folderPath, err := dialog.PromptForSingleSelection()
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "cancel") {
			return "", nil // User cancelled
		}
		return "", err
	}
	return folderPath, nil
}

// SaveFile opens a save file dialog
func (a *App) SaveFile(title string, defaultFilename string) (string, error) {
	dialog := application.Get().Dialog.SaveFileWithOptions(&application.SaveFileDialogOptions{
		Title:    title,
		Filename: defaultFilename,
	})

	savePath, err := dialog.PromptForSingleSelection()
	if err != nil {
		if strings.Contains(strings.ToLower(err.Error()), "cancel") {
			return "", nil // User cancelled
		}
		return "", err
	}
	return savePath, nil
}

// ============ Clipboard & Browser ============

// CopyToClipboard copies text to system clipboard
func (a *App) CopyToClipboard(text string) error {
	if !application.Get().Clipboard.SetText(text) {
		return fmt.Errorf("failed to copy text to clipboard")
	}
	return nil
}

// OpenURL opens an external link in default browser
func (a *App) OpenURL(url string) error {
	return application.Get().Browser.OpenURL(url)
}

// ============ Events & Lifecycle ============

// EmitProgress emits a progress event to the frontend
func (a *App) EmitProgress(progress float64) {
	application.Get().Event.Emit("progress", progress)
}

// EmitStatus emits a status message to the frontend
func (a *App) EmitStatus(status string, statusType string) {
	application.Get().Event.Emit("status", map[string]string{
		"message": status,
		"type":    statusType,
	})
}

// QuitApp closes the application
func (a *App) QuitApp() {
	application.Get().Quit()
}

// ============ Business Logic Example ============

// ProcessData processes items with real-time progress reporting
func (a *App) ProcessData(items []string) (string, error) {
	total := len(items)
	if total == 0 {
		return "", fmt.Errorf("no items to process")
	}

	for i, item := range items {
		// Simulate work
		_ = item

		// Report progress
		progress := float64(i+1) / float64(total) * 100
		a.EmitProgress(progress)
	}

	return fmt.Sprintf("Processed %d items successfully", total), nil
}
